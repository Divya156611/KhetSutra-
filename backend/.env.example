# Kisan Mitra AI Backend Environment Template
APP_NAME="Kisan Mitra AI — Smart Farming Platform"
ENVIRONMENT="development"
DEBUG=True

# Authentication & Security
SECRET_KEY="replace_with_a_secure_random_64_char_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./khetsutra.db"

# Optional External AI API Key (If omitted, uses deterministic agronomy engine)
GEMINI_API_KEY=""

# Get an API key from the Government of India Open Data platform.
# Keep this key in backend environment settings only.
DATA_GOV_IN_API_KEY=""

# Weather API
WEATHER_PROVIDER="open-meteo"
